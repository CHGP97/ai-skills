{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "armbian-skill-release-v1",
  "type": "object",
  "required": [
    "schema_version",
    "skill_name",
    "skill_version",
    "channel",
    "knowledge_release",
    "knowledge_digest",
    "files",
    "reference_ids",
    "acceptance"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "channel": {
      "enum": [
        "development",
        "stable"
      ]
    },
    "knowledge_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    },
    "reference_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
